# =============================================================================
# Debezium CDC Configuration
# =============================================================================
# This file configures the CDC pipeline. Used by:
#   - docker-compose.dev.override.yaml (Kafka Connect)
#   - scripts/setup-cdc.ts (connector creation)
#   - app/oltp/connection.ts (Drizzle ORM)

# =============================================================================
# Source Database
# =============================================================================

# Host access (from your machine / Drizzle Studio)
DB_HOST=localhost
DB_PORT=5433

# # Docker internal access (what Kafka Connect uses)
# DB_HOSTNAME=postgres
# DB_INTERNAL_PORT=5432

# Database credentials
DB_NAME=test-db
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# CDC Connector Settings
# =============================================================================

CDC_CONNECTOR_NAME=postgres-connector
CDC_TOPIC_PREFIX=pg-cdc
CDC_TABLE_INCLUDE_LIST=public.*
CDC_SNAPSHOT_MODE=initial

# PostgreSQL logical replication
CDC_PLUGIN_NAME=pgoutput
CDC_SLOT_NAME=debezium_slot
CDC_PUBLICATION_NAME=dbz_publication

# =============================================================================
# Kafka Connect
# =============================================================================

KAFKA_CONNECT_PORT=8084
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CONNECT_GROUP_ID=cdc-connect-local
KAFKA_REPLICATION_FACTOR=1